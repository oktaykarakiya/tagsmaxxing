# E2E harness configuration — copy to test/.env (gitignored) and edit.
# Every value is read at runtime, so it is hot-swappable: change it here and the
# next `./test/run.sh` picks it up. Keep comments on their own lines (this file is
# both sourced by run.sh and passed to `podman compose --env-file`).

# ── App under test (driven over HTTPS via Caddy; the __Host- session cookie
#    requires Secure, so the browser path must use https) ──────────────────────
BASE_URL=https://localhost:9443
# Set to "true" only if you front the stack with a trusted cert.
E2E_VERIFY_TLS=false
# Bootstrap admin (auto-created on first app boot — see compose.yaml).
KB_TENANT_SLUG=default
KB_ADMIN_EMAIL=admin@local.kb
KB_ADMIN_PASSWORD=admin
# Public base URL the app emits in absolute links/redirects.
PUBLIC_BASE_URL=https://localhost:9443

# ── DeepSeek LLM-as-judge — grades nondeterministic output (tags, summaries).
#    Used only by @pytest.mark.judge tests (the `quality` lane), never the core run.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_JUDGE_MODEL=deepseek-v4-pro
DEEPSEEK_REASONING_EFFORT=high
JUDGE_SAMPLES=1

# ── Inference hardware: gpu (default) or cpu ──────────────────────────────────
E2E_HW=gpu
GPU_DEVICE=nvidia.com/gpu=all
LLAMA_N_GPU_LAYERS=99
LLAMA_CTX_SIZE=8192

# ── Local model files in ./models (repo root), mounted into the llama/whisper
#    servers. Edit if your filenames differ. ───────────────────────────────────
LLAMA_TEXT_MODEL_FILE=Qwen3VL-30B-A3B-Instruct-Q4_K_M.gguf
LLAMA_MMPROJ_FILE=mmproj-Qwen3VL-30B-A3B-Instruct-F16.gguf
LLAMA_EMBED_MODEL_FILE=bge-m3-q8_0.gguf
LLAMA_RERANK_MODEL_FILE=bge-reranker-v2-m3-q8_0.gguf
WHISPER_MODEL_FILE=ggml-large-v3-turbo.bin

# ── App wiring passed through to podman compose ───────────────────────────────
CONFIG_FILE=./test/config.e2e.toml
WHISPER_URL=http://whisper:8080
# Bootstrap creds the app container reads (kept in sync with KB_ADMIN_* above).
BOOTSTRAP_ADMIN_EMAIL=admin@local.kb
BOOTSTRAP_ADMIN_PASSWORD=admin
SESSION_SECRET=e2e-only-session-secret-change-me-not-for-prod-0123456789

# ── Timeouts (seconds) ────────────────────────────────────────────────────────
# Big models load slowly into VRAM; give the stack time to become healthy.
STACK_HEALTH_TIMEOUT=900
JOB_DONE_TIMEOUT=420
HTTP_TIMEOUT=60
