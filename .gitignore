# Build output
/target/

# Coverage artifacts
/lcov.info
*.profraw
*.profdata

# Secrets / local env (never commit; see .env.example)
.env
.env.local
cert.pem
key.pem

# Runtime data
/kb-blobs/
/logs/

# Local config (may contain secrets)
config.toml

# Autonomous build-loop state
/.build-loop/

# Claude Code session artifacts
/.claude/

# Generated dev stylesheet (`just tailwind`); the container builds its own copy.
/crates/api/static/tailwind.css

# Editor noise
*.rs.bk
.DS_Store

# NOTE: Cargo.lock IS committed — this workspace produces an application binary,
# so deterministic builds (and meaningful `cargo audit`/`deny`) require it.
models/
samples/
.fix-loop/
test/.run-up.log
.llama-logs/
