# Local File Knowledge Base — example environment.
# Copy to `.env` (gitignored) and edit. These are documentation + defaults; they are wired in
# incrementally as the relevant crates land (see BUILD_LEDGER.toml).

# ── HTTP API ──────────────────────────────────────────────────────────────────
PORT=9999                       # the app serves on port 9999

# ── Postgres (the only durable state) ──────────────────────────────────────────
POSTGRES_URL=postgres://kb:kb@localhost:5432/kb

# ── Logging (plan §18) ──────────────────────────────────────────────────────────
LOG_LEVEL=info                  # trace|debug|info|warn|error
LOG_FORMAT=json                 # json|pretty
LOG_DIR=./logs
LOG_MAX_GB=5                    # hard cap on log disk usage

# ── Sidecars (plan §2, §14) ──────────────────────────────────────────────────────
TIKA_URL=http://localhost:9998  # Apache Tika (note: distinct from the app's 9999)

# ── Secrets (plan §24) — NEVER commit real values ─────────────────────────────────
SESSION_SECRET=change-me-to-a-long-random-value
# Added in later phases: B2/object-store keys, KMS master key, remote provider API keys,
# Stripe keys, transactional-email provider key.
