# Local File Knowledge Base — example environment.
# Copy to `.env` (gitignored) and edit. These are documentation + defaults; the app reads the
# ones marked "(app)" as they are wired in per crate (see BUILD_LEDGER.toml), while the
# `compose.yaml` sidecar stack reads the ones marked "(compose)". Every compose value also has
# an inline default, so `podman compose up` works even without a `.env`. (Podman only — no Docker.)

# ── HTTP API ──────────────────────────────────────────────────────────────────
PORT=9999                       # (app) the app serves on port 9999

# ── Postgres (the only durable state, plan §5) ──────────────────────────────────
# (app) connection string the application uses. Host/port/creds below must agree with it.
POSTGRES_URL=postgres://kb:kb@localhost:5432/kb
POSTGRES_USER=kb                # (compose) superuser created on first init
POSTGRES_PASSWORD=kb            # (compose) CHANGE for anything but throwaway local dev
POSTGRES_DB=kb                  # (compose) database created on first init
POSTGRES_PORT=5432              # (compose) host port published for Postgres
POSTGRES_BIND=127.0.0.1         # (compose) host interface to publish on (loopback by default)
POSTGRES_IMAGE=docker.io/pgvector/pgvector:pg17   # (compose) Postgres+pgvector image (data-checksums on, §23)

# ── Apache Tika sidecar (plan §2, §14) ──────────────────────────────────────────
TIKA_URL=http://localhost:9998  # (app) Tika endpoint (note: distinct from the app's 9999)
TIKA_PORT=9998                  # (compose) host port published for Tika
TIKA_BIND=127.0.0.1             # (compose) host interface to publish on (loopback by default)
TIKA_IMAGE=docker.io/apache/tika:3.3.0.0  # (compose) minimal server; use the `-full` tag to add OCR

# ── Logging (plan §18) ──────────────────────────────────────────────────────────
LOG_LEVEL=info                  # (app) trace|debug|info|warn|error
LOG_FORMAT=json                 # (app) json|pretty
LOG_DIR=./logs
LOG_MAX_GB=5                    # (app) hard cap on log disk usage

# ── Secrets (plan §24) — NEVER commit real values ─────────────────────────────────
SESSION_SECRET=change-me-to-a-long-random-value
# Added in later phases: B2/object-store keys, KMS master key, remote provider API keys,
# Stripe keys, transactional-email provider key.
