# Local File Knowledge Base — example environment.
# Copy to `.env` (gitignored) and edit. These are documentation + defaults; the app reads the
# ones marked "(app)" as they are wired in per crate (see BUILD_LEDGER.toml), while the
# `compose.yaml` sidecar stack reads the ones marked "(compose)". Every compose value also has
# an inline default, so `podman compose up` works even without a `.env`. (Podman only — no Docker.)

# ── HTTP API ──────────────────────────────────────────────────────────────────
PORT=9999                       # (app) the app serves on port 9999

# ── Postgres (the only durable state, plan §5) ──────────────────────────────────
# (app) PRIVILEGED connection string (owner/superuser): migrations + cross-tenant job queue +
# admin/usage roll-ups. Host/port/creds below must agree with it.
POSTGRES_URL=postgres://kb:kb@localhost:5432/kb
# (app) APPLICATION connection string: the non-privileged `kb_app` role (NOSUPERUSER
# NOBYPASSRLS) auto-created by migration 0006, used for all tenant-scoped data so Postgres RLS
# is enforced (§13, P6-T14). CHANGE the kb_app password for real deployments
# (ALTER ROLE kb_app PASSWORD '…') and update this URL. Leave unset to run single-role.
APP_POSTGRES_URL=postgres://kb_app:kb_app@localhost:5432/kb
POSTGRES_USER=kb                # (compose) superuser created on first init
POSTGRES_PASSWORD=kb            # (compose) CHANGE for anything but throwaway local dev
POSTGRES_DB=kb                  # (compose) database created on first init
POSTGRES_PORT=5432              # (compose) host port published for Postgres
POSTGRES_BIND=127.0.0.1         # (compose) host interface to publish on (loopback by default)
POSTGRES_IMAGE=docker.io/pgvector/pgvector:pg17   # (compose) Postgres+pgvector image (data-checksums on, §23)

# ── Apache Tika sidecar (plan §2, §14) ──────────────────────────────────────────
TIKA_URL=http://localhost:9998  # (app) Tika endpoint (note: distinct from the app's 9999)
TIKA_PORT=9998                  # (compose) host port published for Tika
TIKA_BIND=127.0.0.1             # (compose) host interface to publish on (loopback by default)
TIKA_IMAGE=docker.io/apache/tika:3.3.0.0  # (compose) minimal server; use the `-full` tag to add OCR

# ── App container (plan §14, P7-T1 Containerfile) ──────────────────────────────────
APP_IMAGE=kb:latest             # (compose) the kb image built with `podman build -t kb:latest .`
APP_PORT=9999                   # (compose) host port published for the app
APP_BIND=127.0.0.1              # (compose) host interface to publish on (loopback by default)
CONFIG_FILE=./compose/config.toml  # (compose) deployment config mounted read-only into the app
KB_APP_PASSWORD=kb_app          # (compose) password for the kb_app role (ALTER ROLE to rotate)

# ── Whisper server sidecar (plan §7, §14) ─────────────────────────────────────────
WHISPER_URL=http://localhost:8081   # (app) whisper endpoint for audio transcription
WHISPER_PORT=8081                   # (compose) host port published for whisper-server
WHISPER_BIND=127.0.0.1              # (compose) host interface to publish on
WHISPER_SERVER_IMAGE=docker.io/ghcr.io/ggerganov/whisper.cpp:server  # (compose) whisper.cpp server image
WHISPER_MODEL_PATH=./models         # (compose) directory containing whisper model file(s)
WHISPER_MODEL_FILE=whisper-model.gguf  # (compose) whisper model filename (relative to WHISPER_MODEL_PATH)

# ── Logging (plan §18) ──────────────────────────────────────────────────────────
LOG_LEVEL=info                  # (app) trace|debug|info|warn|error
LOG_FORMAT=json                 # (app) json|pretty
LOG_DIR=./logs
LOG_MAX_GB=5                    # (app) hard cap on log disk usage

# ── llama.cpp server (plan §14, P7-T2 — GPU/CPU inference) ───────────────────────
# Used by both the GPU profile (compose.yaml) and the CPU override (compose.cpu.yaml).
# The GPU profile mounts the GPU via CDI (nvidia.com/gpu=all); the CPU override sets
# LLAMA_ARG_N_GPU_LAYERS=0 and removes the device mount.
LLAMA_SERVER_IMAGE=docker.io/ghcr.io/ggerganov/llama.cpp:server  # (compose) llama.cpp server image
LLAMA_PORT=8080                 # (compose) host port published for llama-server
LLAMA_BIND=127.0.0.1            # (compose) host interface to publish on
LLAMA_MODEL_PATH=./models       # (compose) directory containing GGUF model file(s)
LLAMA_MODEL_FILE=model.gguf     # (compose) model filename (relative to LLAMA_MODEL_PATH)
LLAMA_N_GPU_LAYERS=99           # (compose) number of layers to offload to GPU (99 = all; 0 = CPU-only)
LLAMA_CTX_SIZE=8192             # (compose) context window size in tokens
GPU_DEVICE=nvidia.com/gpu=all   # (compose) CDI device string for Podman GPU passthrough

# ── Secrets (plan §24) — NEVER commit real values ─────────────────────────────────
SESSION_SECRET=change-me-to-a-long-random-value
# Added in later phases: B2/object-store keys, KMS master key, remote provider API keys,
# Stripe keys, transactional-email provider key.
