# kb-postgres.container — Postgres + pgvector + pg_search (ParadeDB).
#
# Two-role RLS model (P6-T14, §13): the POSTGRES_USER is the PRIVILEGED
# owner/superuser for migrations + cross-tenant job queue. Migration 0006
# auto-creates the non-privileged `kb_app` role (NOSUPERUSER NOBYPASSRLS)
# for tenant-scoped data.  Rotate passwords for real deployments.
#
# This container shares the kb.pod network namespace — other pod members
# reach it at localhost:5432.

[Container]
Image=docker.io/paradedb/paradedb:latest
Pod=kb.pod

Environment=POSTGRES_USER=kb POSTGRES_PASSWORD=kb POSTGRES_DB=kb POSTGRES_INITDB_ARGS=--data-checksums

Volume=kb-pgdata.volume:/var/lib/postgresql

# Headroom for parallel pgvector HNSW + ParadeDB BM25 index builds.
ShmSize=268435456

# pg_isready over TCP — the init-phase socket-only server won't false-positive.
HealthCmd=pg_isready -h 127.0.0.1 -p 5432
HealthInterval=10s
HealthTimeout=5s
HealthStartPeriod=30s
HealthRetries=12

[Service]
Restart=on-failure
TimeoutStartSec=120

[Install]
WantedBy=default.target
